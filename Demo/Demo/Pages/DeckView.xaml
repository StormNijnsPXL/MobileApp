<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Demo.Pages.DeckView">
    <VerticalStackLayout>
        <Grid
            ColumnDefinitions="*"
            RowDefinitions="*,*"
            >
            <Grid
                ColumnDefinitions="*,*,*,*"
                RowDefinitions="*,*"
                Grid.Row="0"
                Background="{StaticResource Gray}"
                Margin="20"
                >
                <Button
                    Grid.Column="0"
                    Grid.Row="0"
                    Text="1"
                    Margin="5"
                    />
                <Button
                    Grid.Column="1"
                    Grid.Row="0"
                    Text="2"
                    Margin="5"
                    />
                <Button
                    Grid.Column="2"
                    Grid.Row="0"
                    Text="3"
                    Margin="5"
                    />
                <Button
                    Grid.Column="3"
                    Grid.Row="0"
                    Text="4"
                    Margin="5"
                    />
                <Button
                    Grid.Column="0"
                    Grid.Row="1"
                    Text="5"
                    Margin="5"
                    />
                <Button
                    Grid.Column="1"
                    Grid.Row="1"
                    Text="5"
                    Margin="5"
                    />
                <Button
                    Grid.Column="2"
                    Grid.Row="1"
                    Text="5"
                    Margin="5"
                    />
                <Button
                    Grid.Column="3"
                    Grid.Row="1"
                    Text="5"
                    Margin="5"
                    />

            </Grid>
            <ScrollView
                Margin="0, 20"
                Grid.Row="1"
                Background="{StaticResource Gray}"
                >
                <VerticalStackLayout>
                    <Label
                        Text="Placeholder"
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="Center"
                        FontSize="32"
                        FontFamily="Pixelon"
                        />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
        <ScrollView>
            
        </ScrollView>
    </VerticalStackLayout>
</ContentView>
