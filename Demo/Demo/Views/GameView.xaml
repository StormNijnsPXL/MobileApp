<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tool="clr-namespace:Demo.Models.SkiaSharp"
             xmlns:components="clr-namespace:Demo.Components"
             x:Class="Demo.Pages.GameView"
             >
    <Grid
        RowDefinitions="1*,3*,2*"
        >
        <Grid
            Grid.Row="0"
            >
            <tool:PixelArt
              ImageName="UI/scoreFrame.png"
              WidthRequest="160"
              HeightRequest="65"
              />
            <tool:PixelArt
              ImageName="UI/scoreNeedle.png"
              TranslationY="25"
              WidthRequest="59"
              HeightRequest="59"
              Rotation="-45"
              />
        </Grid>
        
        <Grid
            RowDefinitions="*,*"
            Grid.Row="1"
            >
            <Grid
                ColumnDefinitions="*,*,*,*"
                Grid.Row="0"
                >
                <tool:PixelArt
                    ImageName="UI/cardRed.png"
                    Grid.Column="0"
                    HeightRequest="94"
                    WidthRequest="65"
                    />
                <tool:PixelArt
                    ImageName="UI/cardRed.png"
                    Grid.Column="1"
                    HeightRequest="94"
                    WidthRequest="65"
                    />
                <tool:PixelArt
                    ImageName="UI/cardRed.png"
                    Grid.Column="2"
                    HeightRequest="94"
                    WidthRequest="65"
                    />
                <tool:PixelArt
                    ImageName="UI/cardRed.png"
                    Grid.Column="3"
                    HeightRequest="94"
                    WidthRequest="65"
                    />
            </Grid>
            <Grid
                ColumnDefinitions="*,*,*,*"
                Grid.Row="1"
                >
                <tool:PixelArt
                    ImageName="UI/cardRed.png"
                    Grid.Column="0"
                    HeightRequest="94"
                    WidthRequest="65"
                    />
                <tool:PixelArt
                    ImageName="UI/cardRed.png"
                    Grid.Column="1"
                    HeightRequest="94"
                    WidthRequest="65"
                    />
                <tool:PixelArt
                    ImageName="UI/cardRed.png"
                    Grid.Column="2"
                    HeightRequest="94"
                    WidthRequest="65"
                    />
                <tool:PixelArt
                    ImageName="UI/cardRed.png"
                    Grid.Column="3"
                    HeightRequest="94"
                    WidthRequest="65"
                    />
            </Grid>
        </Grid>
        
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*,*,*"
            >
            <tool:PixelArt
                ImageName="UI/cardSpecial.png"
                Grid.Column="0"
                HeightRequest="94"
                WidthRequest="65"
                />
            <tool:PixelArt
                ImageName="UI/cardSpecial.png"
                Grid.Column="1"
                HeightRequest="94"
                WidthRequest="65"
                />
            <tool:PixelArt
                ImageName="UI/cardSpecial.png"
                Grid.Column="2"
                HeightRequest="94"
                WidthRequest="65"
                />
            <tool:PixelArt
                ImageName="UI/cardSpecial.png"
                Grid.Column="3"
                HeightRequest="94"
                WidthRequest="65"
                />
        </Grid>
    </Grid>
</ContentView>
