<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tool="clr-namespace:Demo.Models.SkiaSharp"
             xmlns:components="clr-namespace:Demo.Components"
             x:Class="Demo.Pages.PlayView">
    <Grid
        ColumnDefinitions="*"
        RowDefinitions="1*,8*,1*,1*"
        >
        <Label 
            Grid.Row="0"
            Text="Tutorial"
            Background="DarkSlateGray"
            FontSize="32"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center"
            VerticalOptions="Fill" 
            HorizontalOptions="Fill" 
            />
        <CollectionView
            x:Name="RoadmapList"
            Grid.Row="1"
            VerticalScrollBarVisibility="Always"
            Margin="20,0"
            >
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <components:RoadMapComponent />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
            
        <Border
            StrokeThickness="0"
            Grid.Row="2"
            HeightRequest="60"
            WidthRequest="160"
            >
            <Border.GestureRecognizers>
                <TapGestureRecognizer 
                    NumberOfTapsRequired="1"
                    Tapped="Play_Clicked" 
                    />
            </Border.GestureRecognizers>
            <Grid>
                <tool:PixelArt
                    ImageName="UI/greenFrame.png"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    />
                <Label
                    FontAutoScalingEnabled="True"
                    FontSize="32"
                    TextColor="White"
                    TranslationY="-6"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Text="PLAY"
                    />
            </Grid>
        </Border>
    </Grid>
</ContentView>
