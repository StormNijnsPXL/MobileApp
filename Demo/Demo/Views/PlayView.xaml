<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tool="clr-namespace:Demo.Controls"
             x:Class="Demo.Pages.PlayView">
    <Grid
        ColumnDefinitions="*"
        RowDefinitions="1*,8*,1*,1*"
        >
        <Label 
            Grid.Row="0"
            Text="Tutorial"
            FontSize="32"
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            />
        <Border
            StrokeThickness="0"
            Grid.Row="2"
            HeightRequest="60"
            WidthRequest="160"
            >
            <Border.GestureRecognizers>
                <TapGestureRecognizer 
                    NumberOfTapsRequired="1"
                    Tapped="Play_Clicked" 
                    />
            </Border.GestureRecognizers>
            <Grid>
                <tool:PixelArt
                    ImageName="UI/greenFrame.png"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    />
                <Label
                    FontAutoScalingEnabled="True"
                    FontSize="32"
                    TextColor="White"
                    TranslationY="-6"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Text="PLAY"
                    />
            </Grid>
        </Border>
    </Grid>
</ContentView>
