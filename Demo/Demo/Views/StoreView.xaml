<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tool="clr-namespace:Demo.Models.SkiaSharp"
             xmlns:components="clr-namespace:Demo.Components"
             x:Class="Demo.Pages.StoreView">
    <VerticalStackLayout
        Padding="20"
        >
        <Grid
            Margin="20,0"
            RowDefinitions="*,*"
            ZIndex="1"
            >
            <Grid
                Background="Maroon"
                >
                <Grid.Shadow>
                    <Shadow
                        Offset="0,4"
                        Brush="Black"
                        Opacity="1"
                        Radius="10"
                        />
                </Grid.Shadow>
            </Grid>
            <tool:OutlinedLabel
                Grid.Row="0"
                Text="Daily Shop"
                FontSize="32"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                />
        </Grid>
        <Grid
            RowDefinitions="1*,9*"
            >
            <Grid
                Grid.Row="0"
                Background="SaddleBrown"
                Padding="10,10,10,0"
                >
                <tool:OutlinedLabel 
                    Grid.Row="1"
                    Text="New"
                    FontSize="20"
                    TextColor="CornflowerBlue"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    />
            </Grid>
            <CollectionView
                x:Name="ShopCollectionView"
                Grid.Row="1"
                ItemsSource="{Binding ShopItems}"
                Background="Chocolate"
                >
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        Orientation="Vertical"
                        Span="3"
                        HorizontalItemSpacing="5"
                        VerticalItemSpacing="5" 
                        />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <components:ShopItem />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </VerticalStackLayout>
</ContentView>
