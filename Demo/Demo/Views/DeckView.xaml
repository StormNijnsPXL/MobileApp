<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cards="clr-namespace:Demo.Models.Cards"
             xmlns:components="clr-namespace:Demo.Components"
             x:Class="Demo.Pages.DeckView">
    <Grid RowDefinitions="*,*">
        <Grid Grid.Row="0"
              RowDefinitions="*"
              Padding="20"
              BackgroundColor="#0B1020">

            <Grid
                x:Name="MenuDeckGrid"
                ColumnDefinitions="*,*,*,*"
                RowDefinitions="*,*"
                ColumnSpacing="8"
                RowSpacing="8" />

        </Grid>
        <CollectionView
            x:Name="MenuCardList"
            Grid.Row="1"
            ItemsSource="{Binding Cards}"
            Margin="0"
            ItemsLayout="VerticalGrid, 4"
            VerticalScrollBarVisibility="Always">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <components:CardComponent />
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentView>
