<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cards="clr-namespace:Demo.Models.Cards"
             xmlns:components="clr-namespace:Demo.Components"
             x:Class="Demo.Pages.DeckView">
    <VerticalStackLayout>
        <Grid
            ColumnDefinitions="*"
            RowDefinitions="*,*"
            >
            <Grid
                ColumnDefinitions="*,*,*,*"
                RowDefinitions="*,*"
                Grid.Row="0"
                Background="Gray"
                Margin="20"
                >
                <CollectionView
                        x:Name="MenuDeckCollection"
                        Grid.ColumnSpan="4"
                        >
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            Orientation="Vertical"
                            Span="4" 
                            />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="cards:Card">
                            <components:CardComponent x:DataType="cards:Card" BindingContext="{Binding .}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
            <ScrollView
                Margin="0, 20"
                Grid.Row="1"
                Background="Gray"
                >
                <VerticalStackLayout>
                    <Label
                        Text="Placeholder"
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="Center"
                        FontSize="32"
                        FontFamily="Pixelon"
                        />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
        <ScrollView>
            
        </ScrollView>
    </VerticalStackLayout>
</ContentView>
