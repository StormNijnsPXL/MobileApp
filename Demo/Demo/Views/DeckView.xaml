<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cards="clr-namespace:Demo.Models.Cards"
             xmlns:components="clr-namespace:Demo.Components"
             x:Class="Demo.Pages.DeckView">
    <VerticalStackLayout>
        <Grid
            ColumnDefinitions="*"
            RowDefinitions="*,*"
            >
            <Grid
                Background="Black"
                Opacity=".75"
                />
            <Grid
                ColumnDefinitions="*,*,*,*"
                RowDefinitions="*,*"
                Grid.Row="0"
                Margin="20"
                >
                <Grid
                    x:Name="MenuDeckGrid"
                    Grid.ColumnSpan="4"
                    ColumnDefinitions="*,*,*,*"
                    RowDefinitions="*,*">
                </Grid>

            </Grid>
            <ScrollView
                Margin="0, 20"
                Grid.Row="1"
                >
                <VerticalStackLayout>
                    <Label
                        Text="Placeholder"
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="Center"
                        FontSize="32"
                        />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
        <ScrollView>
            
        </ScrollView>
    </VerticalStackLayout>
</ContentView>
