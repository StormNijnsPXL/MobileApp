<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:tool="clr-namespace:Demo.Controls"
             x:Class="Demo.MainPage"
             >
    <ContentPage.Resources>
        <Color x:Key="LightGray">#a5a8ac</Color>
        <Color x:Key="Gray">#7f8184</Color>
        <Color x:Key="DarkGray">#222226</Color>
        <Color x:Key="ReallyDarkGray">#18191d</Color>
    </ContentPage.Resources>
    <Grid>
        <Grid x:Name="BackgroundClip"
              IsClippedToBounds="True">

            <Image x:Name="BackgroundImage"
                   Source="cave.png"
                   Aspect="AspectFill"
                   VerticalOptions="Fill"
                   InputTransparent="True" 
                   Scale="1.2"
                   
                   />
        </Grid>
        <Grid
            ColumnDefinitions="*"
            RowDefinitions="1*,8*,1*">

            <Grid
                Grid.Row="0"
                Background="{StaticResource DarkGray}"
                >
                <Grid
                    ColumnDefinitions="2*,5*,5*"
                    RowDefinitions="*,*"
                    Padding="10"
                    >
                    <Label
                        Grid.ColumnSpan="2"
                        Text="Username"
                        HorizontalTextAlignment="Start"
                        VerticalTextAlignment="Center"
                        FontAutoScalingEnabled="True"
                        TextColor="LightBlue"
                        />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Lv.1"
                        HorizontalTextAlignment="Start"
                        VerticalTextAlignment="Center"
                        FontAutoScalingEnabled="True"
                        TextColor="Gold"
                        />
                    <ProgressBar
                        Grid.Row="1"
                        Grid.Column="1"
                        Progress=".5"
                        ProgressColor="Gold"
                        VerticalOptions="End"
                        />
                    <Image
                        Grid.Column="2"
                        HorizontalOptions="End"
                        Source="settings.svg"
                        HeightRequest="40"
                        Aspect="AspectFit"
                        />
                </Grid>
            </Grid>
            <Grid x:Name="AppGrid"
                Grid.Row="1"
                >
                <Grid.GestureRecognizers>
                    <SwipeGestureRecognizer
                        Direction="Left"
                        Swiped="AppViewSwiped"
                        />
                    <SwipeGestureRecognizer
                        Direction="Right"
                        Swiped="AppViewSwiped"
                        />
                </Grid.GestureRecognizers>
                <Label
                  Text="App"
                  HorizontalTextAlignment="Center"
                  VerticalTextAlignment="Center"
                  FontSize="32"
                  />
            </Grid>


            <Grid
                Grid.Row="2"
                Background="{StaticResource Gray}"
                ColumnDefinitions="*,*,*,*,*">

                <Border
                    x:Name="MenuStoreBtn"
                    Grid.Column="0"
                    >
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer 
                            NumberOfTapsRequired="1"
                            Tapped="Menu_Button_Clicked" 
                            />
                    </Border.GestureRecognizers>
                    <tool:PixelArt
                       ImageName="Icons/play.png"
                       HeightRequest="50"
                       WidthRequest="50" 
                       />
                </Border>
                <Border
                    x:Name="MenuDeckBtn"
                    Grid.Column="1"
                    >
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer 
                            NumberOfTapsRequired="1"
                            Tapped="Menu_Button_Clicked" 
                            />
                    </Border.GestureRecognizers>
                    <tool:PixelArt
                       ImageName="Icons/play.png"
                       HeightRequest="50"
                       WidthRequest="50" 
                       />
                </Border>
                <Border
                    x:Name="MenuPlayBtn"
                    Grid.Column="2"
                    >
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer 
                            NumberOfTapsRequired="1"
                            Tapped="Menu_Button_Clicked" 
                            />
                    </Border.GestureRecognizers>
                    <tool:PixelArt
                       ImageName="Icons/play.png"
                       HeightRequest="50"
                       WidthRequest="50" 
                       />
                </Border>
                <Border
                    x:Name="MenuQuestsBtn"
                    Grid.Column="3"
                    >
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer 
                            NumberOfTapsRequired="1"
                            Tapped="Menu_Button_Clicked" 
                            />
                    </Border.GestureRecognizers>
                    <tool:PixelArt
                        ImageName="Icons/play.png"
                        HeightRequest="50"
                        WidthRequest="50" 
                        />
                </Border>
                <Border
                    x:Name="MenuLeadboardBtn"
                    Grid.Column="4"
                    >
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer 
                            NumberOfTapsRequired="1"
                            Tapped="Menu_Button_Clicked" 
                            />
                    </Border.GestureRecognizers>
                    <tool:PixelArt
                        ImageName="Icons/play.png"
                        HeightRequest="50"
                        WidthRequest="50" 
                        />
                </Border>

            </Grid>
            
        </Grid>

        <Grid
              x:Name="LoadingScreenBackground"
              BackgroundColor="{StaticResource ReallyDarkGray}"
              IsVisible="True">

            <!-- LEFT -->
            <Grid
                x:Name="LoadingScreenLeft"
                WidthRequest="400"
                HeightRequest="400"
                BackgroundColor="{StaticResource DarkGray}"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Rotation="45"
                TranslationX="-230"
                TranslationY="100">

                <Grid
                    WidthRequest="250"
                    HeightRequest="250"
                    BackgroundColor="{StaticResource LightGray}"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    TranslationX="-50">

                    <Grid
                        WidthRequest="2"
                        HeightRequest="125"
                        TranslationX="-25"
                        BackgroundColor="{StaticResource Gray}"
                        HorizontalOptions="End"
                        VerticalOptions="Center" />

                    <Grid
                        WidthRequest="150"
                        HeightRequest="2"
                        TranslationY="25"
                        BackgroundColor="{StaticResource Gray}"
                        HorizontalOptions="Start"
                        VerticalOptions="Start" />

                </Grid>
            </Grid>


            <!-- RIGHT -->
            <Grid
                x:Name="LoadingScreenRight"
                WidthRequest="400"
                HeightRequest="400"
                BackgroundColor="{StaticResource DarkGray}"
                HorizontalOptions="End"
                VerticalOptions="Center"
                Rotation="-45"
                TranslationX="230"
                TranslationY="-100">

                <Grid
                    WidthRequest="250"
                    HeightRequest="250"
                    BackgroundColor="{StaticResource LightGray}"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    TranslationX="50">

                    <Grid
                        WidthRequest="2"
                        HeightRequest="125"
                        TranslationX="25"
                        BackgroundColor="{StaticResource Gray}"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" />

                    <Grid
                        WidthRequest="150"
                        HeightRequest="2"
                        TranslationY="25"
                        BackgroundColor="{StaticResource Gray}"
                        HorizontalOptions="End"
                        VerticalOptions="Start" />

                </Grid>
            </Grid>

            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="20"
                >

                <ActivityIndicator
                    IsRunning="True"
                    Color="White"
                    WidthRequest="50"
                    HeightRequest="50" />

                <Label
                    Text="Loading..."
                    TextColor="White"
                    FontSize="24"
                    HorizontalOptions="Center"
                    />
            </VerticalStackLayout>

            <Label
                 Text="v1.0"
                 TextColor="#818387"
                 FontSize="20"
                 FontAttributes="Italic"
                 Margin="5,10"
                 VerticalOptions="End"
                 HorizontalOptions="End" 
                 HorizontalTextAlignment="End"
                 />
        </Grid>
        
    </Grid>

</ContentPage>
