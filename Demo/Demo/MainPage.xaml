<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Demo.MainPage"
             >
    <ContentPage.Resources>
        <Color x:Key="LightGray">#a5a8ac</Color>
        <Color x:Key="Gray">#7f8184</Color>
        <Color x:Key="DarkGray">#222226</Color>
        <Color x:Key="ReallyDarkGray">#18191d</Color>
    </ContentPage.Resources>
    <Grid>
        <Grid
            ColumnDefinitions="*"
            RowDefinitions="1*,8*,1*">

            <Grid
                Grid.Row="0"
                Background="{StaticResource Gray}"
                >
                <Label
                    Text="Profile"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    FontSize="32"
                    FontFamily="Pixelon"
                    />
            </Grid>
            <Grid x:Name="AppGrid"
                Grid.Row="1"
                Background="{StaticResource LightGray}"
                >
                <Label
                  Text="App"
                  HorizontalTextAlignment="Center"
                  VerticalTextAlignment="Center"
                  FontSize="32"
                  FontFamily="Pixelon"
                  />
            </Grid>


            <Grid
                Grid.Row="2"
                Background="{StaticResource Gray}"
                ColumnDefinitions="*,*,*,*,*">

                <Button x:Name="MenuStoreBtn"
                    Grid.Column="0"
                    Text="Store"
                    FontFamily="Pixelon"
                    FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    CornerRadius="0"
                    Padding="0"
                    Clicked="Menu_Button_Clicked" />

                <Button x:Name="MenuDeckBtn"
                    Grid.Column="1"
                    Text="Deck"
                    FontFamily="Pixelon"
                    FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    CornerRadius="0"
                    Padding="0"
                    Clicked="Menu_Button_Clicked" />

                <Button x:Name="MenuPlayBtn"
                    Grid.Column="2"
                    Text="Play"
                    FontFamily="Pixelon"
                    FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    CornerRadius="0"
                    Padding="0"
                    Clicked="Menu_Button_Clicked" />

                <Button x:Name="MenuQuestsBtn"
                    Grid.Column="3"
                    Text="Quests"
                    FontFamily="Pixelon"
                    FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    CornerRadius="0"
                    Padding="0"
                    Clicked="Menu_Button_Clicked" />

                <Button x:Name="MenuLeadboardBtn"
                    Grid.Column="4"
                    Text="Leaderboard"
                    FontFamily="Pixelon"
                    FontSize="14"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    CornerRadius="0"
                    Padding="0"
                    Clicked="Menu_Button_Clicked" />

            </Grid>



        </Grid>

        <Grid
              x:Name="LoadingScreenBackground"
              BackgroundColor="{StaticResource ReallyDarkGray}"
              IsVisible="True">

            <!-- LEFT -->
            <Grid
                x:Name="LoadingScreenLeft"
                WidthRequest="400"
                HeightRequest="400"
                BackgroundColor="{StaticResource DarkGray}"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Rotation="45"
                TranslationX="-230"
                TranslationY="100">

                <Grid
                    WidthRequest="250"
                    HeightRequest="250"
                    BackgroundColor="{StaticResource LightGray}"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    TranslationX="-50">

                    <Grid
                        WidthRequest="2"
                        HeightRequest="125"
                        TranslationX="-25"
                        BackgroundColor="{StaticResource Gray}"
                        HorizontalOptions="End"
                        VerticalOptions="Center" />

                    <Grid
                        WidthRequest="150"
                        HeightRequest="2"
                        TranslationY="25"
                        BackgroundColor="{StaticResource Gray}"
                        HorizontalOptions="Start"
                        VerticalOptions="Start" />

                </Grid>
            </Grid>


            <!-- RIGHT -->
            <Grid
                x:Name="LoadingScreenRight"
                WidthRequest="400"
                HeightRequest="400"
                BackgroundColor="{StaticResource DarkGray}"
                HorizontalOptions="End"
                VerticalOptions="Center"
                Rotation="-45"
                TranslationX="230"
                TranslationY="-100">

                <Grid
                    WidthRequest="250"
                    HeightRequest="250"
                    BackgroundColor="{StaticResource LightGray}"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    TranslationX="50">

                    <Grid
                        WidthRequest="2"
                        HeightRequest="125"
                        TranslationX="25"
                        BackgroundColor="{StaticResource Gray}"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" />

                    <Grid
                        WidthRequest="150"
                        HeightRequest="2"
                        TranslationY="25"
                        BackgroundColor="{StaticResource Gray}"
                        HorizontalOptions="End"
                        VerticalOptions="Start" />

                </Grid>
            </Grid>

            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="20"
                >

                <ActivityIndicator
                    IsRunning="True"
                    Color="White"
                    WidthRequest="50"
                    HeightRequest="50" />

                <Label
                    FontFamily="Pixelon"
                    Text="Loading..."
                    TextColor="White"
                    FontSize="24"
                    HorizontalOptions="Center"
                    />
            </VerticalStackLayout>

            <Label
                 FontFamily="Pixelon"
                 Text="v1.0"
                 TextColor="#818387"
                 FontSize="20"
                 FontAttributes="Italic"
                 Margin="5,10"
                 VerticalOptions="End"
                 HorizontalOptions="End" 
                 HorizontalTextAlignment="End"
                 />
        </Grid>
        
    </Grid>

</ContentPage>
