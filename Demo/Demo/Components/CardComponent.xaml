<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Demo.Components.CardComponent">
    <Border
        Stroke="#555555"
        StrokeThickness="1"
        BackgroundColor="#252525"
        Padding="8"
        Margin="4"
        StrokeShape="RoundRectangle 10">

        <VerticalStackLayout Spacing="8">
            <Grid
                ColumnDefinitions="*,*,*"
                RowDefinitions="*,*"
                Background="Gray">
                <Image
                    Source="dotnet_bot.png"
                    HeightRequest="70"
                    Aspect="AspectFit" 
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="3"
                    />
                <Image
                    Source="dotnet_bot.png"
                    HeightRequest="20"
                    Aspect="AspectFit" 
                    
                    />
            <Label
                Text="{Binding Name}"
                FontFamily="Pixelon"
                FontSize="14"
                TextColor="White"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap" 
                Grid.Row="0"
                Grid.ColumnSpan="3"
                />
            </Grid>
        </VerticalStackLayout>

    </Border>
</ContentView>
