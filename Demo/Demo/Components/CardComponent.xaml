<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tool="clr-namespace:Demo.Controls"
             x:Class="Demo.Components.CardComponent">
    <Border
        Stroke="#5599FF"
        StrokeThickness="1"
        BackgroundColor="Gray"
        Padding="4"
        Margin="4"
        StrokeShape="RoundRectangle 2"
        >
        
        <Border.Shadow>
            <Shadow
                Brush="#6688FF"
                Offset="0,0"
                Radius="10"
                Opacity="0.8" />
        </Border.Shadow>

        <Grid
            ColumnDefinitions="*,*,*"
            RowDefinitions="*,*,*"
            Background="Gray">
            <tool:PixelArt
                Grid.Row="1"
                Grid.RowSpan="1"
                Grid.ColumnSpan="3"
                ImageName="Icons/play.png"
                HeightRequest="40"
                WidthRequest="40" 
                VerticalOptions="Center"
                />
            <tool:PixelArt
                ImageName="Icons/play.png"
                HeightRequest="20"
                WidthRequest="20"
                VerticalOptions="Center"
                />
            <Label
                Text="Level 1"
                TextColor="White"
                FontAutoScalingEnabled="True"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                LineBreakMode="NoWrap" 
                Grid.Row="2"
                Grid.ColumnSpan="3"
                />
        </Grid>

    </Border>
</ContentView>
