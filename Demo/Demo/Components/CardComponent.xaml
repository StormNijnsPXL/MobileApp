<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tool="clr-namespace:Demo.Models.SkiaSharp"
             xmlns:cards="clr-namespace:Demo.Models.Cards"
             x:Class="Demo.Components.CardComponent">
    <Border
        Stroke="#5599FF"
        StrokeThickness="0"
        Padding="0"
        Margin="4"
        StrokeShape="RoundRectangle 2"
        HeightRequest="94"
        WidthRequest="65"
        >
        
        <Border.Shadow>
            <Shadow
                Brush="{Binding Rarity.Color}"
                Offset="0,0"
                Radius="6"
                Opacity="1" />
        </Border.Shadow>
        
        <Grid
            ColumnDefinitions="*,*,*"
            RowDefinitions="*,*,*">
            <tool:PixelArt
                Grid.Row="0"
                Grid.RowSpan="999"
                Grid.ColumnSpan="999"
                ImageName="{Binding Rarity.CardArt}"
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                />
            <tool:PixelArt
                Grid.Row="1"
                Grid.RowSpan="1"
                Grid.ColumnSpan="3"
                ImageName="{Binding ImageUrl}"
                HeightRequest="40"
                WidthRequest="40" 
                VerticalOptions="Center"
                />

            <Border
                TranslationX="5"
                TranslationY="2"
                StrokeThickness="0"
                StrokeShape="Ellipse"
                Scale="1.2"
                >
                <Grid>
                    <tool:PixelArt
                        ImageName="Icons/energy.png"
                        HeightRequest="20"
                        WidthRequest="20"
                        VerticalOptions="Center"
                        />
                    <tool:OutlinedLabel
                        Text="{Binding Cost}"
                        TextColor="AliceBlue"
                        FontSize="16"
                        OutlineColor="DarkSlateBlue"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        LineBreakMode="NoWrap" 
                    />
                </Grid>
            </Border>
            <tool:OutlinedLabel
                Text="Level 1"
                TextColor="White"
                FontSize="14"
                FontAutoScalingEnabled="True"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                LineBreakMode="NoWrap" 
                Grid.Row="2"
                Grid.ColumnSpan="3"
                />
        </Grid>

    </Border>
</ContentView>
