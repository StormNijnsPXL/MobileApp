<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tool="clr-namespace:Demo.Models.SkiaSharp"
             x:Class="Demo.Components.RoadMapTileComponent">

    <Border
        Grid.Column="{Binding Slot}"
        StrokeThickness="0"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        >

        <Border.Shadow>
            <Shadow
                Brush="SaddleBrown"
                Offset="0,0"
                Radius="6"
                Opacity="0.3" />
        </Border.Shadow>

        <Grid>
            <tool:PixelArt
                ImageName="UI/roadmapTile.png"
                WidthRequest="50"
                HeightRequest="50" />

            <Grid RowDefinitions="*,*">
                <tool:PixelArt
                    ImageName="{Binding ImageUrl}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HeightRequest="30"
                    WidthRequest="30" />

                <Label
                    Text="{Binding Title}"
                    Grid.Row="1"
                    FontSize="10"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TextColor="White" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
