<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Demo.Components"
             x:Class="Demo.Components.RoadMapComponent">
    <Grid
        ColumnDefinitions="*,*,*"
        RowDefinitions="*,*"
        Margin="10,0"
        >

        <Image
            Grid.ColumnSpan="3"
            Grid.RowSpan="2"
            Source="roadmapcave1.png"
            Aspect="AspectFill"
            VerticalOptions="Fill"
            HorizontalOptions="Fill" 
            />

        <components:RoadMapTileComponent
            x:Name="TopTile"
            Grid.Row="0" />

        <components:RoadMapTileComponent
            x:Name="BottomTile"
            Grid.Row="1" />
    </Grid>
</ContentView>
